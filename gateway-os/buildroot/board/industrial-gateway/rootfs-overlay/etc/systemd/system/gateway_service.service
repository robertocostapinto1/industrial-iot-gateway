[Unit]
Description=Industrial IoT Gateway Ingestion Service
After=network.target mosquitto.service
Requires=mosquitto.service

[Service]
Type=simple
ExecStart=/usr/bin/gateway_service
Restart=always
RestartSec=5
# Security Hardening
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
